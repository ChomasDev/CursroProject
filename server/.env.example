PORT=3000
NODE_ENV=development

# Claude via Anthropic Messages API. Sonnet 4.6 keeps temperature 0.9 for the roast.
# claude-sonnet-5 is the Claude Code default, but it rejects a custom temperature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Perplexity Agent API. "fast" is a short web lookup with citations.
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=fast

HOURLY_WAGE_EUR=15.50
